rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // YAPPATHON FIRESTORE RULES
    // Clean replacement for the broken rules file.
    //
    // IMPORTANT:
    // The previous voiceCalls block was accidentally nested inside
    // dms/{dmId}/messages/{messageId}. That meant requests to the
    // real top-level /voiceCalls collection never matched the voice
    // rules at all, causing "Missing or insufficient permissions".
    // Voice calls are now a top-level collection.
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function rootAdmin() {
      return signedIn() && request.auth.token.email == 'admin@yappathon.com';
    }

    function admin() {
      return rootAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // ============================================================
    // USERS / PROFILES / SETTINGS / SECRETS
    // ============================================================

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['member', 'admin'];

      // The owner may save profile settings, avatar, timetable,
      // hidden-DM state and secrets. Admins may change another user's role.
      allow update: if signedIn() && (
        request.auth.uid == uid
        || admin()
      );

      allow delete: if false;

      // Optional separate secrets collection. This is supported in addition
      // to a `secrets` field on the user document.
      match /secrets/{secretId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // ============================================================
    // PUBLIC CHANNELS
    // ============================================================

    match /channels/{channelId} {
      allow read: if signedIn();

      // Default channels can be created by logged-in users. Admins can
      // create additional public channels.
      allow create: if signedIn();

      // Admins can delete public channels, as requested.
      allow delete: if admin();

      allow update: if admin();

      match /messages/{messageId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;

        // Own messages can be edited/deleted. Admins can moderate them.
        allow update: if signedIn()
          && (
            resource.data.uid == request.auth.uid
            || admin()
          );

        allow delete: if signedIn()
          && (
            resource.data.uid == request.auth.uid
            || admin()
          );
      }
    }

    // ============================================================
    // DMs / GROUP DMs
    // ============================================================

    match /dms/{dmId} {
      // The DM list uses membership queries in the client. Allowing
      // authenticated reads here avoids rules rejecting valid list queries
      // before individual documents can be inspected.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members;

      // Members can update group metadata, hidden state, avatar/name, etc.
      allow update: if signedIn()
        && (
          request.auth.uid in resource.data.members
          || admin()
        );

      allow delete: if admin();

      match /messages/{messageId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;

        // Allows message editing and reaction changes. The client remains
        // responsible for the exact message/reaction UI.
        allow update: if signedIn()
          && (
            resource.data.uid == request.auth.uid
            || admin()
            || request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.members
          );

        allow delete: if signedIn()
          && (
            resource.data.uid == request.auth.uid
            || admin()
          );
      }
    }

    // ============================================================
    // VOICE CALLS
    // ============================================================
    //
    // This MUST be at the database root level:
    //   /voiceCalls/{callId}
    //
    // It is intentionally not nested under /dms. The voice client performs
    // getDoc() before creating a call, so a nonexistent call document must
    // be readable as a normal "doesn't exist" result.
    //
    // Firestore's `get`/document read rules can return null for a missing
    // document. The explicit `resource == null` check handles that initial
    // existence check. See Firebase's Rules API documentation for get()
    // returning null when a document does not exist.

    match /voiceCalls/{callId} {
      // Voice signaling is ephemeral. Any authenticated YAPPATHON user may
      // read call state so the DM/group invite listener can reliably see an
      // active call. Audio itself is NOT stored in Firestore.
      allow read: if signedIn();

      // DM, group and public-channel calls.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.kind in ['channel', 'dm', 'group']
        && request.resource.data.contextId is string
        && request.resource.data.name is string
        && request.resource.data.members is list;

      // Caller heartbeat, ending a call and call expiry updates.
      // Participants may update an active call.
      allow update: if signedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || request.auth.uid in resource.data.members
          || resource.data.kind == 'channel'
        );

      allow delete: if signedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || admin()
        );

      // ----------------------------------------------------------
      // INCOMING CALL INVITES
      // ----------------------------------------------------------

      match /invites/{inviteUid} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.uid == inviteUid;

        allow update: if signedIn()
          && (
            request.auth.uid == inviteUid
            || resource.data.from == request.auth.uid
            || admin()
          );

        allow delete: if signedIn()
          && (
            request.auth.uid == inviteUid
            || admin()
          );
      }

      // ----------------------------------------------------------
      // WEBRTC PRESENCE
      // ----------------------------------------------------------

      match /presence/{presenceUid} {
        allow read: if signedIn();

        allow create, update: if signedIn()
          && request.auth.uid == presenceUid;

        allow delete: if signedIn()
          && request.auth.uid == presenceUid;
      }

      // ----------------------------------------------------------
      // WEBRTC SIGNALING
      // ----------------------------------------------------------

      match /signals/{signalId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to is string
          && request.resource.data.type in ['offer', 'answer', 'candidate'];

        allow update, delete: if false;
      }
    }

    // ============================================================
    // OPTIONAL GENERAL PURPOSE USER ACHIEVEMENTS / SECRETS
    // ============================================================

    match /secrets/{secretId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }
  }
}
