rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function rootAdmin() {
      return signedIn() && request.auth.token.email == 'admin@yappathon.com';
    }

    function admin() {
      return rootAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // ------------------------------------------------------------
    // USERS / PROFILES / TIMETABLE / SECRETS
    // ------------------------------------------------------------
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['member','admin'];
      allow update: if signedIn() && (request.auth.uid == uid || admin());
      allow delete: if false;

      match /secrets/{secretId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // ------------------------------------------------------------
    // PUBLIC CHANNELS
    // ------------------------------------------------------------
    match /channels/{channelId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if admin();
      allow delete: if admin();

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;

        // Owners may edit their own text OR let the profile-history sync
        // update only their username/PFP on old messages.
        allow update: if signedIn() && (
          admin()
          || (
            resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'text','editedAt','username','photoBase64'
            ])
          )
        );

        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      }
    }

    // ------------------------------------------------------------
    // DMS / GROUP DMS
    // ------------------------------------------------------------
    match /dms/{dmId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && (request.auth.uid in resource.data.members || admin());
      allow delete: if admin();

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;

        // Members may change reactions; owners may edit text and their
        // username/PFP history. Admins may moderate.
        allow update: if signedIn() && (
          admin()
          || request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.members
        );

        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      }
    }

    // ------------------------------------------------------------
    // VOICE CALLS
    // ------------------------------------------------------------
    // There is intentionally ONE voiceCalls block. The previous rules file
    // contained two overlapping blocks, which made the voice rules difficult
    // to reason about and caused conflicting behavior.
    match /voiceCalls/{callId} {
      // The app can always check whether a call exists before setDoc().
      // Authenticated users can read call state; WebRTC media is peer-to-peer.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.kind in ['channel','dm','group']
        && request.resource.data.contextId is string
        && request.resource.data.name is string
        && request.resource.data.members is list;

      allow update: if signedIn() && (
        resource.data.createdBy == request.auth.uid
        || request.auth.uid in resource.data.members
        || resource.data.kind == 'channel'
      );

      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || admin());

      match /invites/{inviteUid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == inviteUid
          && request.resource.data.status == 'ringing';
        allow update: if signedIn() && (
          request.auth.uid == inviteUid
          || resource.data.from == request.auth.uid
          || admin()
        );
        allow delete: if signedIn() && (request.auth.uid == inviteUid || admin());
      }

      match /presence/{presenceUid} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == presenceUid
          && request.resource.data.uid == presenceUid;
        allow delete: if signedIn() && request.auth.uid == presenceUid;
      }

      match /signals/{signalId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to is string
          && request.resource.data.type in ['offer','answer','candidate'];
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------
    // ACHIEVEMENT / SECRET DOCUMENTS
    // ------------------------------------------------------------
    match /secrets/{secretId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
